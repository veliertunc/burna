---
import { Burner } from "@/components/burner"
import Layout from "@/layouts/main.astro"

Astro.response.headers.set("X-Frame-Options", "DENY")
---

<Layout>
  <main class="mx-auto flex min-h-svh w-full max-w-xl flex-col gap-7 px-5 py-10 sm:py-16">
    <header class="space-y-3">
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
        Local disc burner
      </p>
      <h1 class="text-4xl font-semibold tracking-tight">Burna</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        Write disc images and data files to a CD or DVD using a writer connected
        to your Mac.
      </p>
    </header>
    <div class="border border-border bg-card p-4 sm:p-6">
      <Burner client:load />
    </div>
  </main>
</Layout>
